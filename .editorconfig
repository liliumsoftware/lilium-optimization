# Keeps IntelliJ's formatter aligned with checkstyle.xml (Google checks adapted to this project): reformatting with
# these settings produces code that passes the Checkstyle build.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.java]
indent_style = space
indent_size = 4
max_line_length = 120
ij_continuation_indent_size = 8
ij_java_imports_layout = *, |, java.**, javax.**, |, $*
ij_java_class_count_to_use_import_on_demand = 999
ij_java_names_count_to_use_import_on_demand = 999
ij_java_align_multiline_parameters = false
# Javadoc is wrapped by hand: IntelliJ's Javadoc re-flow is not stable around inline tags and leaves one-word lines
ij_java_doc_enable_formatting = false
ij_java_doc_indent_on_continuation = true
ij_java_if_brace_force = always
ij_java_for_brace_force = always
ij_java_while_brace_force = always
ij_java_do_while_brace_force = always
ij_java_keep_simple_blocks_in_one_line = false
ij_java_keep_simple_methods_in_one_line = false
ij_java_keep_simple_classes_in_one_line = false
ij_java_space_before_array_initializer_left_brace = true
ij_java_blank_lines_after_imports = 1
ij_java_wrap_comments = false

[{checkstyle*.xml,*.properties}]
indent_style = space
indent_size = 4

# The Maven Release Plugin writes empty POM elements as <x />; IntelliJ keeps that form
[pom.xml]
indent_style = space
indent_size = 4
ij_xml_space_inside_empty_tag = true

[*.{yml,yaml}]
indent_style = space
indent_size = 2

[*.md]
indent_size = 2
trim_trailing_whitespace = false
